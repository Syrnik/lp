msgid "Live Placeholder"
msgstr "Динамические подсказки поиска"

msgid "Search field selector"
msgstr "Селектор поля поиска"

msgid "CSS selector of the input element whose placeholder attribute will be animated"
msgstr "Селектор элемента, у которого надо менять атрибут placeholder"

msgid "Phrase list"
msgstr "Список подсказок"

msgid "One phrase per line. Leave empty to disable the plugin"
msgstr "Одна строка — одна подсказка. Если оставить пустым, плагин выключится"

msgid "Search and you shall find"
msgstr "Ищите и обрящете"

msgid "Minimum typing speed"
msgstr "Минимальная скорость набора"

msgid "Minimum delay between characters, ms. Higher = slower"
msgstr "Минимальная задержка между символами, мс. Больше — медленнее"

msgid "Maximum typing speed"
msgstr "Максимальная скорость набора"

msgid "Maximum delay between characters, ms"
msgstr "Максимальная задержка между символами, мс"

msgid "Pause between phrases"
msgstr "Пауза между подсказками"

msgid "Delay after a phrase is fully typed, ms"
msgstr "Задержка после полного набора подсказки, мс"

msgid "Letter-by-letter erasure"
msgstr "Стирать посимвольно"

msgid "Erase the current phrase character by character before showing the next one"
msgstr "Стирать текущую подсказку посимвольно перед показом следующей"
